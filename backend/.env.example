NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/citizen_health
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_long_random_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM=no-reply@citizenhealth.gov

# Optional — AI Integration Layer (health assistant, risk explainer).
# Leave unset to run with the AI layer disabled (graceful fallback responses).
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
